			(plotpadnumbers no)
			(hidednponfab no)
			(sketchdnponfab no)
			(crossoutdnponfab no)
			(subtractmaskfromsilk no)
			(outputformat 1)
			(mirror no)
			(drillshape 0)
			(scaleselection 1)
			(outputdirectory "gerber/")
